[Unit]
Description=Samah Laravel queue worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/Prt-Samah
ExecStart=/usr/bin/php /var/www/Prt-Samah/artisan queue:work --sleep=1 --tries=3 --timeout=120 --max-time=3600
Nice=10

[Install]
WantedBy=multi-user.target
